            ]
          }
        },
        "required": [
          "idempotencyKey",
          "checkId",
          "sku",
          "price",
          "evidence",
          "conditions"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_status",
      "description": "读取当前核验结果、证据、净利润与通知状态；省略 checkId 时分页列出当前空间记录。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
