{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/mcp.js": { "maxDuration": 60 },
    "api/auth/*.js": { "maxDuration": 60 },
    "api/dashboard.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/", "missing": [{ "type": "host", "value": "haoyangmao.koocuu.com" }], "destination": "https://haoyangmao.koocuu.com/", "permanent": false },
    { "source": "/:path*", "missing": [{ "type": "host", "value": "haoyangmao.koocuu.com" }], "destination": "https://haoyangmao.koocuu.com/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
